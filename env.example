# 复制本文件为 .env 并填入 API Key，即可启用 AI 理解、文案生成、配图与视频等功能。

# OpenAI（推荐，用于 GPT 图片/视频生成）
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# 或使用通用兼容变量名
# AIPC_LLM_API_KEY=
# AIPC_LLM_BASE_URL=https://api.openai.com/v1

# 图片生成模型（参考图 + 提示词走 /images/edits）
# AIPC_IMAGE_MODEL=gpt-image-1

# 视频生成模型（参考图作为首帧，走 /videos）
# AIPC_VIDEO_MODEL=sora-2
# AIPC_VIDEO_SIZE=720x1280
# AIPC_VIDEO_SECONDS=8
# AIPC_VIDEO_TIMEOUT=300

# 阿里云 DashScope（可选，用于文字/图片理解）
# DASHSCOPE_API_KEY=

# 可选：超时（秒）；百炼绘图较慢，建议 AIPC_IMAGE_TIMEOUT=360
# AIPC_LLM_TIMEOUT=90
# AIPC_IMAGE_TIMEOUT=360
