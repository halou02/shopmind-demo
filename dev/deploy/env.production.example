# 服务器演示环境配置（复制为项目根目录 .env）
# 密钥只放在服务器上，不要提交到 Git 或发给评委

DASHSCOPE_API_KEY=sk-你的百炼演示密钥

# 兼容接口（文字 / 部分能力）
AIPC_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AIPC_LLM_MODEL=qwen-plus

# 图片生成
AIPC_IMAGE_MODEL=wan2.2-t2i-flash

# 服务监听（由 systemd 注入，一般不用改）
SHOPMIND_HOST=0.0.0.0
SHOPMIND_PORT=8080

# 服务器上不要自动打开浏览器
SHOPMIND_OPEN_BROWSER=0

# 超时（秒）
AIPC_LLM_TIMEOUT=120
